# =============================================================================
# Production template — copy to .env on the server (do not commit secrets)
# =============================================================================

APP_ENV=production
APP_TIMEZONE=Asia/Kolkata

# Admin + customer frontends that call the API (comma-separated, no spaces after commas)
CORS_ORIGINS=https://apipos.v11tech.com,https://posv11tech.web.app,https://posv11tech.firebaseapp.com

# --- Database ---
DB_HOST=your_mysql_host
DB_PORT=3306
DB_NAME=restaurant_pos
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# --- JWT (use a long random string, e.g. openssl rand -hex 32) ---
JWT_SECRET=CHANGE_TO_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MinIO ---
MINIO_ENDPOINT=storage.v11tech.com
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=uploads
MINIO_SECURE=true
MINIO_PUBLIC_ENDPOINT=https://storage.v11tech.com

# --- SMTP ---
EMAIL_ENABLED=true
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USERNAME=accounts@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SENDER_EMAIL=accounts@yourdomain.com
SENDER_NAME=Restaurant POS
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Razorpay LIVE (SaaS subscriptions) ---
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_WITH_LIVE_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
# Webhook URL: https://apipos.v11tech.com/api/v1/billing/razorpay/webhook
