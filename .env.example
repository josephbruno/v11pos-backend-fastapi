# =============================================================================
# V11 POS Backend — environment template
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================================

# --- Application ---
APP_ENV=development
# production | development — production enforces CORS_ORIGINS (no wildcard *)
APP_TIMEZONE=Asia/Kolkata

# Comma-separated browser origins allowed to call the API (required when APP_ENV=production)
# Example: https://admin.yourdomain.com,https://order.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Database (MySQL) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=fastapi_pos
DB_USER=pos_user
DB_PASSWORD=change_me

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MinIO / S3-compatible storage ---
MINIO_ENDPOINT=storage.example.com
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=minio_secret_key
MINIO_BUCKET=uploads
MINIO_SECURE=true
MINIO_PUBLIC_ENDPOINT=https://storage.example.com

# --- SMTP (customer OTP / notifications) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SENDER_NAME=Restaurant POS
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Platform Razorpay (SaaS subscription billing for restaurant admins) ---
# Test keys: rzp_test_... | Live keys: rzp_live_...
# Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
# Dashboard → Settings → Webhooks → secret for signature verification
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
#
# Register this URL in Razorpay Dashboard (Settings → Webhooks):
#   https://<your-api-host>/api/v1/billing/razorpay/webhook
#
# Enable events:
#   subscription.authenticated, subscription.activated, subscription.charged,
#   subscription.cancelled, subscription.halted, payment.failed
